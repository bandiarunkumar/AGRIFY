# =================================================================
# AGRIFY — Environment Variables (.env.example)
# Copy this file to .env and fill in your real keys
# =================================================================

# ---------------------------------------------------------------
# CORE FLASK
# ---------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-me-to-something-long-and-random

# ---------------------------------------------------------------
# POSTGRESQL DATABASE
# Create a DB: createdb agriconnect
# ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/agriconnect

# ---------------------------------------------------------------
# OPENWEATHERMAP (One Call 3.0 or 2.5 free tier)
# Sign up: https://openweathermap.org/api
# ---------------------------------------------------------------
OPENWEATHERMAP_API_KEY=your_api_key_here

# ---------------------------------------------------------------
# SOILGRIDS / ISRIC (Free – no key needed, but rate-limited)
# Uses: https://rest.isric.org/soilgrids/v2.0/
# SOILHIVE (optional premium): https://soilhive.ag
# ---------------------------------------------------------------
SOILHIVE_API_KEY=

# ---------------------------------------------------------------
# GOOGLE EARTH ENGINE (optional satellite)
# Register: https://earthengine.google.com/
# Place your service account JSON as ee_credentials.json in backend/
# ---------------------------------------------------------------
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_FILE=ee_credentials.json

# ---------------------------------------------------------------
# AGRICULTURE NEWS (optional – NewsAPI)
# Sign up: https://newsapi.org/
# ---------------------------------------------------------------
NEWSAPI_KEY=

# ---------------------------------------------------------------
# GEMINI / OPENAI for chatbot and Agent Core (Phase 3F-1 Gateway)
# ---------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------
# AI MODEL GATEWAY (Phase 3F-1)
# AI_PROVIDER_PRIMARY: gemini | openai | auto  (default: gemini)
# AI_PROVIDER_TIMEOUT_SECONDS: per-provider timeout in seconds (default: 12)
# GEMINI_MODEL: override Gemini model name (default: gemini-2.5-flash)
# OPENAI_MODEL: override OpenAI model name (default: gpt-4o-mini)
# ---------------------------------------------------------------
AI_PROVIDER_PRIMARY=gemini
AI_PROVIDER_TIMEOUT_SECONDS=12
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------
# GOOGLE CLOUD TRANSLATION (optional; used by /api/translate)
# Keep the real key only in this directory's ignored .env file.
# ---------------------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=

# ---------------------------------------------------------------
# CORS / FRONTEND
# ---------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
