# AGRIFY Frontend — Environment Configuration
# Copy this file to .env (local development) and fill in values.
# Never commit real secrets, API keys, or production database URLs.

# Core Backend API — must be set explicitly; staging never falls back to production.
# Example (staging): https://agri-connect-main-app-staging.onrender.com
# Example (production): https://agri-connect-main-app.onrender.com
VITE_API_BASE_URL=

# Crop Doctor Image API — must be set explicitly; staging never falls back to production.
# Example (staging): https://agri-connect-image-staging.onrender.com
# Example (production): https://agri-connect-image.onrender.com
VITE_IMAGE_API_BASE_URL=
